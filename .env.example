PORT=3000
COUCHBASE_URL=couchbase://localhost
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=troque-esta-senha
COUCHBASE_BUCKET=agendamentos
COUCHBASE_SCOPE=_default
COUCHBASE_COLLECTION_USERS=users
COUCHBASE_COLLECTION_EVENTS=events
COUCHBASE_COLLECTION_ENROLLMENTS=enrollments
COUCHBASE_COLLECTION_SESSIONS=sessions
SESSION_SECRET=troque-esta-chave
# Embeddings e busca semantica
# Opcion A (recomendada, gratuita): Ollama local, endpoint OpenAI-compatible.
# Ollama corre no host (localhost:11434). Se a API roda en Docker Desktop,
# usa EMBEDDINGS_URL=http://host.docker.internal:11434/v1/embeddings
# EMBEDDINGS_URL=http://localhost:11434/v1/embeddings
# EMBEDDINGS_API_KEY=ollama
# EMBEDDINGS_MODEL=nomic-embed-text
# EMBEDDINGS_DIMENSIONS=768
# Opcion B (paga): API oficial de OpenAI.
# EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# EMBEDDINGS_API_KEY=troque-sua-chave-openai
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_DIMENSIONS=1536
# Se deixa EMBEDDINGS_API_KEY baleiro, a busca semantica queda desactivada
# (novos eventos non reciben embedding e /api/events/semantic-search -> 503).
EMBEDDINGS_API_KEY=
COUCHBASE_VECTOR_INDEX=events-vector-index
BENCH_INSERTS=1000
BENCH_READS=1000
BENCH_READS_PAGINATED=200
BENCH_PAGE_SIZE=20
BENCH_UPDATES=500
BENCH_AGGREGATES=200
BENCH_DELETES=500
BENCH_CONCURRENCY=50
BENCH_SAMPLE_INTERVAL_MS=200
# Estimativas ilustrativas de custo (nao sao precos oficiais de nenhum provedor)
BENCH_PRICE_VCPU_HOUR=0.034
BENCH_PRICE_PER_MILLION_OPS=0.20
BENCH_PRICE_GB_MONTH=0.023
